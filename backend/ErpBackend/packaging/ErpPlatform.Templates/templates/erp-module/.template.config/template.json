{
  "$schema": "http://json.schemastore.org/template",
  "author": "ERP Platform",
  "classifications": ["ERP", "Module", "Web"],
  "identity": "ErpPlatform.ErpModule",
  "name": "ERP Platform Module (skeleton)",
  "shortName": "erp-module",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "ErpModule",
  "preferNameDirectory": false,
  "symbols": {
    "rootNamespace": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "ErpApp.Modules",
      "replaces": "ErpApp.Modules",
      "description": "Namespace for the generated module."
    },
    "resource": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "items",
      "replaces": "erp-resource",
      "description": "Route resource segment, e.g. sales/customers."
    },
    "prefix": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "items",
      "replaces": "erp-prefix",
      "description": "Permission prefix, e.g. customers."
    }
  }
}
