{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "ErpBackend",
    "Audience": "ErpBackend.Client",
    "SecretKey": "dev-only-secret-key-change-me-please-32+chars",
    "AccessTokenExpirationMinutes": 60
  },
  "ErpLogging": {
    "EnableRequestLogging": true,
    "EnablePerformanceLogging": true,
    "SlowRequestThresholdMs": 1000
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "Identity": {
    "DefaultAdmin": {
      "UserName": "admin",
      "Email": "admin@erp.local",
      "Password": "Admin123!"
    },
    "DemoViewerPassword": "Viewer123!"
  },
  "ConnectionStrings": {
    "Default": "Data Source=erp-platform.dev.db"
  }
}
