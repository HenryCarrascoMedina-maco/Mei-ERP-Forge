<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package metadata. Assembly/namespace stay ErpBackend.* (rename is a later follow-up);
       only the published PackageId is the product name. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Ship the XML doc file without requiring 100% doc coverage. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>ErpPlatform.CrossCutting</PackageId>
    <Title>ERP Platform — CrossCutting</Title>
    <Description>Reusable ASP.NET Core cross-cutting layer for the ERP Platform: standard API responses and pagination, exceptions with global error handling, correlation/request/performance logging, audit, JWT authentication and permission-based authorization, helpers, and file/export/import utilities.</Description>
    <PackageTags>erp;platform;aspnetcore;crosscutting;api;jwt;authorization;pagination;framework</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- CrossCutting hosts shared middleware, DI/builder extensions and security plumbing,
       so it needs the ASP.NET Core framework types (HttpContext, IApplicationBuilder, etc.). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
  </ItemGroup>

</Project>
