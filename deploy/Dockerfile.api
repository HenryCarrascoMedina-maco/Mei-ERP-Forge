# syntax=docker/dockerfile:1
# Build context: backend/ErpBackend  (see deploy/docker-compose.yml)

# ---- build ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish ErpBackend.Api/ErpBackend.Api.csproj -c Release -o /app

# ---- runtime ----
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

# Non-root user + a writable data dir for the SQLite file (mounted as a volume in compose).
RUN useradd -u 10001 -m appuser \
    && mkdir -p /data \
    && chown -R appuser:appuser /data
USER appuser

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "ErpBackend.Api.dll"]
