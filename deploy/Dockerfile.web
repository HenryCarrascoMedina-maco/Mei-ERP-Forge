# syntax=docker/dockerfile:1
# Build context: frontend/erp-frontend  (see deploy/docker-compose.yml)

# ---- build the Angular app (production: apiUrl '/api', same-origin) ----
FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run ng -- build erp-frontend --configuration production

# ---- serve with Caddy (static + reverse proxy + automatic HTTPS) ----
FROM caddy:2-alpine AS runtime
# Angular's application builder emits the client bundle under dist/<project>/browser.
COPY --from=build /src/dist/erp-frontend/browser /srv
# The Caddyfile is mounted at runtime by docker-compose (./Caddyfile -> /etc/caddy/Caddyfile).
