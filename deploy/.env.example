# Copy to deploy/.env (gitignored) and fill in. NEVER commit real secrets.

# --- Reverse proxy / TLS (web/Caddy) ---
# Production: a real hostname -> automatic HTTPS (Let's Encrypt).
# Local docker smoke test: use ":80" for plain HTTP.
DOMAIN=demo.erpforge.dev
ACME_EMAIL=ops@meicarort.example

# --- Backend (api) ---
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Sqlite
Database__MigrateOnStartup=true
ConnectionStrings__Default=Data Source=/data/erp.db

# JWT signing key — MUST be a strong 32+ char secret, provided here (never committed).
Jwt__SecretKey=CHANGE_ME_to_a_strong_32+_character_secret
Jwt__Issuer=ErpForge
Jwt__Audience=ErpForge.Client

# Initial admin + demo viewer (demo credentials; change for any real deployment).
Identity__DefaultAdmin__UserName=admin
Identity__DefaultAdmin__Email=admin@erpforge.dev
Identity__DefaultAdmin__Password=CHANGE_ME_admin_password
Identity__DemoViewerPassword=CHANGE_ME_viewer_password

# Module permissions granted to the seeded Administrator role + shown in the role editor.
Identity__AdditionalAdminPermissions__0=customers.view
Identity__AdditionalAdminPermissions__1=customers.create
Identity__AdditionalAdminPermissions__2=customers.update
Identity__AdditionalAdminPermissions__3=customers.delete
Identity__AdditionalAdminPermissions__4=products.view
Identity__AdditionalAdminPermissions__5=products.create
Identity__AdditionalAdminPermissions__6=products.update
Identity__AdditionalAdminPermissions__7=products.delete

# Seed demo business data (customers/products) so the demo looks real. Leave unset/false for real installs.
Demo__Seed=true

# Optional CORS lock-down (same-origin demo doesn't need it). Example:
# Cors__AllowedOrigins__0=https://demo.erpforge.dev
